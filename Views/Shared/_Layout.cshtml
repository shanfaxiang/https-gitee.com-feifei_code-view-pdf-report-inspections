<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 报告浏览</title>
    <link rel="icon" href="~/images/favicon.png" type="image/png" />
    <link href="~/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap-icons/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
</head>
<body>
    @* ===== 顶部导航栏（德臻科技风格）===== *@
    <header class="top-navbar">
        <div class="top-navbar-inner d-flex align-items-center">
            <a class="brand d-flex align-items-center" href="@Url.Action("Index", "Home")">
                <img src="~/images/logo.png" alt="德臻科技 DezhenTech" class="brand-logo" />
                <span class="brand-divider"></span>
                <span class="brand-title">@(ViewData["Title"] ?? "报告浏览")</span>
            </a>

            <nav class="top-nav d-flex align-items-center">
                <a class="top-nav-link active" href="@Url.Action("Index", "Home")">
                    <i class="bi bi-house-door-fill me-1"></i>首页
                </a>
            </nav>

            <div class="ms-auto d-flex align-items-center top-right">
                <div class="text-end me-3 d-none d-md-block">
                    <div class="top-date" id="topDate">--</div>
                    <div class="top-time" id="topTime">--:--:--</div>
                </div>
                <span class="badge env-badge"><i class="bi bi-circle-fill me-1"></i>正式环境</span>
                <span class="top-version d-none d-lg-inline">v1.0.0-0929-000</span>
                <div class="dropdown ms-2">
                    <a class="dropdown-toggle user-menu" href="#" data-bs-toggle="dropdown">
                        <i class="bi bi-person-circle me-1"></i>系统管理员
                    </a>
                    <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                        <li><a class="dropdown-item" href="javascript:void(0);"><i class="bi bi-person me-2"></i>个人信息</a></li>
                        <li><a class="dropdown-item" href="javascript:void(0);"><i class="bi bi-gear me-2"></i>设置</a></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li><a class="dropdown-item" href="javascript:void(0);"><i class="bi bi-box-arrow-right me-2"></i>退出登录</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </header>

    <main class="page-body">
        @RenderBody()
    </main>

    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
